# Where the Go backend runs. Defaults to http://localhost:8080 when unset.
# Set it at build time for a deployment, e.g. VITE_API_URL=https://api.your-domain.in
VITE_API_URL=http://localhost:8080
# Or several backends, comma-separated: each browser tab picks one at random and
# moves to another when one fails. Production builds take theirs from .env.production.
# VITE_API_URLS=https://one.onrender.com,https://two.onrender.com
