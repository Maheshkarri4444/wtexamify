# Copy to backend/.env and fill in. Real environment variables override this file.

MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Use a database of its own for local development, so test data never mixes with real exams.
DB_NAME=examify_local
PORT=8080
JWT_SECRET=change-me-to-a-long-random-string

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must also be listed as an authorised redirect URI in the Google Cloud console.
GOOGLE_REDIRECT_URL=http://localhost:5173/google/callback

# development enables /auth/dev-login (localhost only). Leave empty in production.
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Extra teacher emails, comma-separated, on top of the list in controllers/auth_controller.go
TEACHER_EMAILS=
# Non-RGUKT emails allowed to sign in as students (for testing with a personal Gmail)
TEST_STUDENT_EMAILS=

# Checks external exams' code answers (Run, and marking after submit). Get a key at
# https://aistudio.google.com/apikey. The free tier allows only a few checks a minute;
# use a paid key for real exams.
GEMINI_API_KEY=
# Optional backup keys, comma-separated. With GEMINI_API_KEY they make the key pool: every
# student writing an external gets a key of their own when they start (and frees it on
# submitting); a key that's refused or over its limit is swapped for one nobody holds.
# A key from another Google project has its own quota. GET /api/v2/teacher/ai-keys shows the pool.
GEMINI_BACKUP_API_KEYS=
# Optional: models to try in order, comma-separated, and how many checks may run at once
# (left empty: two per key, between 8 and 64).
GEMINI_MODELS=
GEMINI_CONCURRENCY=
